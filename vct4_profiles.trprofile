    {
      "name": "robo",
      "customHotkey": null,
      "customHotstring": {
        "sequence": "=cp",
        "instant": true
      },
      "targetWindow": null,
      "useRelativeCoordinates": false,
      "windowWidth": 0,
      "windowHeight": 0,
      "windowX": 0,
      "windowY": 0,
      "restorePosition": false,
      "restoreSize": false,
      "bringToFocus": false,
      "triggerMode": "OnPress",
      "batchDelay": "Delay (ms)",
      "isDisabled": false,
      "enableLoop": false,
      "loopCount": 1,
      "loopIntervalEnabled": false,
      "loopInterval": 200,
      "actions": [
        {
          "id": "5dcfaff504074141a25723ab9fa661e9",
          "actionType": "SendText",
          "key": "\uD83D\uDCE2 Aviso importante!\nO Roblox colocou uma nova verifica\u00E7\u00E3o de seguran\u00E7a em algumas contas, para confirmar que voc\u00EA n\u00E3o \u00E9 um rob\u00F4. \uD83E\uDD16\uD83D\uDEAB\nO que voc\u00EA precisa fazer:\n\n1\uFE0F\u20E3 Pegue seu celular\n2\uFE0F\u20E3 Escolha as imagens conforme as instru\u00E7\u00F5es que aparecerem na tela\n3\uFE0F\u20E3 Complete at\u00E9 a verifica\u00E7\u00E3o terminar \u2705\n\n\u26A0\uFE0F S\u00F3 voc\u00EA consegue fazer essa verifica\u00E7\u00E3o \u2014 n\u00F3s n\u00E3o temos como resolver isso por voc\u00EA, pois \u00E9 uma seguran\u00E7a da sua pr\u00F3pria conta.\n\uD83D\uDC68\u200D\uD83D\uDC69\u200D\uD83D\uDC67 Se tiver alguma dificuldade, pe\u00E7a ajuda para um adulto ou respons\u00E1vel para te acompanhar nesse passo.\nQualquer d\u00FAvida, estamos aqui! \uD83D\uDCAC{Enter}",
          "x": 0,
          "y": 0,
          "delay": 25,
          "comment": "",
          "imagePath": null,
          "timeout": 5000,
          "confidence": 0.8,
          "keyHtml": "\u003Cp\u003E\u003Cspan style=\u0022white-space:pre-wrap;\u0022\u003E\uD83D\uDCE2 \u003C/span\u003E\u003Cb\u003E\u003Cstrong style=\u0022white-space:pre-wrap;\u0022\u003EAviso importante!\u003C/strong\u003E\u003C/b\u003E\u003C/p\u003E\u003Cp\u003E\u003Cspan style=\u0022white-space:pre-wrap;\u0022\u003EO Roblox colocou uma nova verifica\u00E7\u00E3o de seguran\u00E7a em algumas contas, para confirmar que voc\u00EA n\u00E3o \u00E9 um rob\u00F4. \uD83E\uDD16\uD83D\uDEAB\u003C/span\u003E\u003C/p\u003E\u003Cp\u003E\u003Cb\u003E\u003Cstrong style=\u0022white-space:pre-wrap;\u0022\u003EO que voc\u00EA precisa fazer:\u003C/strong\u003E\u003C/b\u003E\u003C/p\u003E\u003Cp\u003E\u003Cbr\u003E\u003Cspan style=\u0022white-space:pre-wrap;\u0022\u003E1\uFE0F\u20E3 Pegue seu celular\u003C/span\u003E\u003Cbr\u003E\u003Cspan style=\u0022white-space:pre-wrap;\u0022\u003E2\uFE0F\u20E3 Escolha as imagens conforme as instru\u00E7\u00F5es que aparecerem na tela\u003C/span\u003E\u003Cbr\u003E\u003Cspan style=\u0022white-space:pre-wrap;\u0022\u003E3\uFE0F\u20E3 Complete at\u00E9 a verifica\u00E7\u00E3o terminar \u2705\u003C/span\u003E\u003C/p\u003E\u003Cp\u003E\u003Cbr\u003E\u003C/p\u003E\u003Cp\u003E\u003Cspan style=\u0022white-space:pre-wrap;\u0022\u003E\u26A0\uFE0F S\u00F3 voc\u00EA consegue fazer essa verifica\u00E7\u00E3o \u2014 n\u00F3s n\u00E3o temos como resolver isso por voc\u00EA, pois \u00E9 uma seguran\u00E7a da sua pr\u00F3pria conta.\u003C/span\u003E\u003C/p\u003E\u003Cp\u003E\u003Cspan style=\u0022white-space:pre-wrap;\u0022\u003E\uD83D\uDC68\u200D\uD83D\uDC69\u200D\uD83D\uDC67 Se tiver alguma dificuldade, pe\u00E7a ajuda para um adulto ou respons\u00E1vel para te acompanhar nesse passo.\u003C/span\u003E\u003C/p\u003E\u003Cp\u003E\u003Cspan style=\u0022white-space:pre-wrap;\u0022\u003EQualquer d\u00FAvida, estamos aqui! \uD83D\uDCAC\u003C/span\u003E\u003Cspan data-token=\u0022{Enter}\u0022\u003E{Enter}\u003C/span\u003E\u003C/p\u003E",
          "keyMarkdown": "\uD83D\uDCE2 *Aviso importante!*\nO Roblox colocou uma nova verifica\u00E7\u00E3o de seguran\u00E7a em algumas contas, para confirmar que voc\u00EA n\u00E3o \u00E9 um rob\u00F4. \uD83E\uDD16\uD83D\uDEAB\n*O que voc\u00EA precisa fazer:*\n\n1\uFE0F\u20E3 Pegue seu celular\n2\uFE0F\u20E3 Escolha as imagens conforme as instru\u00E7\u00F5es que aparecerem na tela\n3\uFE0F\u20E3 Complete at\u00E9 a verifica\u00E7\u00E3o terminar \u2705\n\n\u26A0\uFE0F S\u00F3 voc\u00EA consegue fazer essa verifica\u00E7\u00E3o \u2014 n\u00F3s n\u00E3o temos como resolver isso por voc\u00EA, pois \u00E9 uma seguran\u00E7a da sua pr\u00F3pria conta.\n\uD83D\uDC68\u200D\uD83D\uDC69\u200D\uD83D\uDC67 Se tiver alguma dificuldade, pe\u00E7a ajuda para um adulto ou respons\u00E1vel para te acompanhar nesse passo.\nQualquer d\u00FAvida, estamos aqui! \uD83D\uDCAC{Enter}",
          "repeatCount": 1,
          "holdDurationMs": 0
        }
      ],
