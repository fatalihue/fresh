      "actions": [
        {
          "id": "7a828b3c7b0541938e2a76b245f9bbe3",
          "actionType": "SendText",
          "key": "\uD83D\uDE4B\u200D\u2642\uFE0F\uD83D\uDE0E Ol\u00E1!\n\nNosso hor\u00E1rio de atendimento \u00E9:\n\nTODOS os dias de 09:00 \u00E0s 00:00\n\nVoc\u00EA logo ser\u00E1 atendido por um de nossos atendentes caso esteja dentro do hor\u00E1rio de atendimento.\n\nAo ser atendido, por gentileza, permane\u00E7a online no chat.{Enter}",
          "x": 0,
          "y": 0,
          "delay": 50,
          "comment": null,
          "imagePath": null,
          "timeout": 30000,
          "confidence": 0.8,
          "keyHtml": "\u003Cp\u003E\u003Cspan style=\u0022white-space:pre-wrap;\u0022\u003E\uD83D\uDE4B\u200D\u2642\uFE0F\uD83D\uDE0E Ol\u00E1!\u003C/span\u003E\u003Cbr\u003E\u003Cbr\u003E\u003Cspan style=\u0022white-space:pre-wrap;\u0022\u003ENosso hor\u00E1rio de atendimento \u00E9:\u003C/span\u003E\u003Cbr\u003E\u003Cbr\u003E\u003Ci\u003E\u003Cb\u003E\u003Cstrong style=\u0022white-space:pre-wrap;\u0022\u003ETODOS os dias de 09:00 \u00E0s 00:00\u003C/strong\u003E\u003C/b\u003E\u003C/i\u003E\u003Cbr\u003E\u003Cbr\u003E\u003Cspan style=\u0022white-space:pre-wrap;\u0022\u003EVoc\u00EA logo ser\u00E1 atendido por um de nossos atendentes caso esteja dentro do hor\u00E1rio de atendimento.\u003C/span\u003E\u003Cbr\u003E\u003Cbr\u003E\u003Cspan style=\u0022white-space:pre-wrap;\u0022\u003EAo ser atendido, por gentileza, permane\u00E7a online no chat.\u003C/span\u003E\u003Cspan data-token=\u0022{Enter}\u0022\u003E{Enter}\u003C/span\u003E\u003C/p\u003E",
          "keyMarkdown": "\uD83D\uDE4B\u200D\u2642\uFE0F\uD83D\uDE0E Ol\u00E1!\n\nNosso hor\u00E1rio de atendimento \u00E9:\n\n*_TODOS os dias de 09:00 \u00E0s 00:00_*\n\nVoc\u00EA logo ser\u00E1 atendido por um de nossos atendentes caso esteja dentro do hor\u00E1rio de atendimento.\n\nAo ser atendido, por gentileza, permane\u00E7a online no chat.{Enter}",
          "repeatCount": 1,
          "holdDurationMs": 0
        },
