        {
          "id": "1c0a06b812a848cd95435eaff1887d6c",
          "actionType": "SendText",
          "key": "Nenhum pedido foi localizado com essas informa\u00E7\u00F5es. Por favor verifique se enviou os dados corretos para que seu pedido possa ser encontrado!\n\nInfome qualquer uma dessas op\u00E7\u00F5es:\n\n1. E-MAIL cadastrado em nosso site.\n2. Nome completo do pagador.\n3. N\u00FAmero do pedido (ID da compra);\n4. Comprovante de Pagamento PIX.{enter}",
          "x": 0,
          "y": 0,
          "delay": 50,
          "comment": null,
          "imagePath": null,
          "timeout": 30000,
          "confidence": 0.8,
          "repeatCount": 1,
          "holdDurationMs": 0,
          "isInsertionPoint": false,
          "isVisuallyDeselected": false,
          "shouldHighlight": false,
          "displayX": "",
          "displayY": "",
          "displayKey": "Nenhum pedido foi localizado com essas informa\u00E7\u00F5es. Por favor verifique se enviou os dados corretos para que seu pedido possa ser encontrado!\n\nInfome qualquer uma dessas op\u00E7\u00F5es:\n\n1. E-MAIL cadastrado em nosso site.\n2. Nome completo do pagador.\n3. N\u00FAmero do pedido (ID da compra);\n4. Comprovante de Pagamento PIX.{enter}"
        }
